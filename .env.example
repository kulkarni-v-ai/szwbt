# SMTP Server Configuration (Production / Staging Mailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@szwbt2026.org
SMTP_FROM_NAME=South Zone Badminton Championship 2026
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# Security & OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=300

# Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
